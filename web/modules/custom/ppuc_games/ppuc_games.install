<?php

/**
 * @file
 * Install and update hooks for ppuc_games.
 */

declare(strict_types=1);

use Drupal\taxonomy\Entity\Term;

/**
 * The Opto_16 board type, as shipped in default content.
 *
 * Kept in step with
 * web/sites/default/files/default_content/taxonomy_term/f453b0b1-b024-4ab8-80fd-e6c734c045bf.json
 * - the uuid is deliberately the same, so a later default content import treats
 * this as the entity it already knows rather than creating a second one.
 */
const PPUC_GAMES_OPTO_16_UUID = 'f453b0b1-b024-4ab8-80fd-e6c734c045bf';

/**
 * Connector pin to GPIO for an Opto_16.
 *
 * 16 opto-isolated inputs on the same GPIOs as the IO_16_8_1's, plus pin 25,
 * the WS2812 connector every board carries.
 */
function _ppuc_games_opto_16_gpio_mapping(): array {
  $mapping = [];
  for ($pin = 1; $pin <= 16; $pin++) {
    $mapping[$pin] = 2 + $pin;
  }
  $mapping[25] = 29;
  return $mapping;
}

/**
 * Adds the Opto_16 board type to sites that already exist.
 *
 * A fresh install gets it from default content. An existing one does not, and
 * cannot: the import runs with --preserve-ids, and the file carries a term id
 * that any site with a hand-created taxonomy term will already have used. The
 * importer skips an entity whose id is taken, silently, so the board type never
 * arrives and the game wizard refuses to allocate opto switches.
 *
 * Creating it here sidesteps ids entirely. Matching on uuid keeps a later
 * default content import from adding a second one.
 */
function ppuc_games_update_11001(): string {
  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');

  $existing = $storage->loadByProperties(['uuid' => PPUC_GAMES_OPTO_16_UUID]);
  if ($existing) {
    return 'Opto_16 board type already present, nothing to do.';
  }

  // Also by name: a site may have created it by hand to get the wizard working.
  $byName = $storage->loadByProperties(['vid' => 'i_o_board', 'name' => 'Opto_16']);
  if ($byName) {
    return 'A board type called Opto_16 already exists, left as it is.';
  }

  $term = Term::create([
    'vid' => 'i_o_board',
    'uuid' => PPUC_GAMES_OPTO_16_UUID,
    'name' => 'Opto_16',
    'description' => [
      'value' => '<p><a href="https://github.com/PPUC/Hardware_Opto_16">https://github.com/PPUC/Hardware_Opto_16</a></p>'
      . '<p>16 opto-isolated inputs, on the same GPIOs as the IO_16_8_1\'s, plus the WS2812 '
      . 'connector every board carries. It has no PWM output stage, so it holds no coils - but '
      . 'it can drive an LED string.</p>',
      'format' => 'basic_html',
    ],
    'field_gpio_mapping' => serialize(_ppuc_games_opto_16_gpio_mapping()),
  ]);
  $term->save();

  return sprintf('Created the Opto_16 board type (term %s).', $term->id());
}

/**
 * Give every existing game a PPUC settings record.
 *
 * They used to be added by hand from an "Add PPUC Settings" button, so no game
 * had one and every exported ppuc.ini was built from the exporter's fallbacks -
 * nothing an operator changed could be stored, and the values did not travel
 * with the game. New games get theirs on insert; this is the one-off backfill
 * for the games that already exist.
 */
function ppuc_games_update_11002(): string {
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $settings = \Drupal::service('ppuc_games.game_settings');

  $ids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'game')
    ->execute();

  if (!$ids) {
    return 'No games, nothing to do.';
  }

  $created = 0;
  foreach ($storage->loadMultiple($ids) as $game) {
    if ($settings->find($game) === NULL) {
      $settings->getOrCreate($game);
      $created++;
    }
  }

  return sprintf(
    '%d game(s) checked, %d settings record(s) created.',
    count($ids),
    $created
  );
}

/**
 * Give settings records a uuid derived from their game, and drop duplicates.
 *
 * Records created by update 11002 got a random uuid, which made them a
 * different entity from the one an archive carries. Importing a game then
 * produced two: the one hook_node_insert created while the game was being
 * imported, and the archive's own a moment later. The lookup takes the newest,
 * which is the empty one, so importing a game silently discarded every ini
 * value it had.
 *
 * Deduplication keeps whichever record actually holds settings rather than
 * whichever is newer, because the newer one is exactly the empty placeholder.
 */
function ppuc_games_update_11003(): string {
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $settings_service = \Drupal::service('ppuc_games.game_settings');

  $game_ids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'game')
    ->execute();

  if (!$game_ids) {
    return 'No games, nothing to do.';
  }

  $renamed = 0;
  $deleted = 0;

  foreach ($storage->loadMultiple($game_ids) as $game) {
    $ids = $storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('type', 'ppuc_settings')
      ->condition('field_game.target_id', $game->id())
      ->execute();

    if (!$ids) {
      continue;
    }

    $records = $storage->loadMultiple($ids);

    // The one carrying the most settings is the one somebody configured.
    usort($records, static function ($a, $b): int {
      $filled = static function ($node): int {
        $count = 0;
        foreach ($node->getFields() as $name => $field) {
          if (str_starts_with($name, 'field_ini_') && !$field->isEmpty()) {
            $count++;
          }
        }
        return $count;
      };
      return [$filled($b), $b->getCreatedTime()] <=> [$filled($a), $a->getCreatedTime()];
    });

    $keep = array_shift($records);
    if ($records !== []) {
      $storage->delete($records);
      $deleted += count($records);
    }

    $uuid = $settings_service->uuidFor($game);
    if ($keep->uuid() !== $uuid) {
      $keep->set('uuid', $uuid)->save();
      $renamed++;
    }
  }

  return sprintf(
    '%d game(s) checked, %d settings record(s) given a derived uuid, %d duplicate(s) removed.',
    count($game_ids),
    $renamed,
    $deleted
  );
}

/**
 * Implements hook_update_N().
 *
 * Removes the slowStable switch debounce mode.
 *
 * It was never a debounce mode. Both it and Standard used the same window -
 * the debounce value in milliseconds - and the firmware treated them
 * identically everywhere except one line, which kept a slowStable switch off
 * the interrupt commit path. Such a switch was only ever committed from the
 * board's poll loop, so it reported late, and on a board whose poll loop was
 * not running it never reported at all.
 *
 * That failure is silent and looks exactly like broken hardware. A machine
 * spent a day appearing to have a dead coin door switch, which left three of
 * its four boards refusing high power, and two dead drop target bank
 * switches, which meant the banks never reset. All three were slowStable; the
 * individual targets beside them were Standard and worked perfectly.
 *
 * Switches are moved to Standard and keep their debounce value, so timing is
 * unchanged. Only the commit path differs, which is the point.
 */
function ppuc_games_update_11004(): string {
  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $node_storage = \Drupal::entityTypeManager()->getStorage('node');

  $slow = $term_storage->loadByProperties(['uuid' => '01d97733-2522-4b50-aec8-862a7fb4f4c5']);
  $slow = $slow ? reset($slow) : NULL;

  if (!$slow) {
    return 'slowStable term is already gone, nothing to do.';
  }

  $standard = $term_storage->loadByProperties(['uuid' => '0d8d70b5-5c4d-486a-a738-cebe3279f67d']);
  $standard = $standard ? reset($standard) : NULL;

  if (!$standard) {
    // Repointing at nothing would leave the field empty, which the exporter
    // reads as standard anyway - but the editing UI would show a blank mode
    // and the next person would have to guess. Better to stop than to guess
    // for them.
    throw new \RuntimeException('Cannot migrate slowStable switches: the Standard debounce term is missing.');
  }

  $ids = $node_storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('field_debounce_mode.target_id', $slow->id())
    ->execute();

  $moved = 0;
  foreach ($node_storage->loadMultiple($ids) as $switch) {
    $switch->set('field_debounce_mode', ['target_id' => $standard->id()]);
    $switch->save();
    $moved++;
  }

  $slow->delete();

  return sprintf('Moved %d switch(es) from slowStable to Standard and removed the term.', $moved);
}
